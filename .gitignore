# 下载产物 / 书库（个人数据，不入库）
outputs/
# 运行状态与配置（每日计数、输出目录设置）
.asase/
.state/
# 开发期缓存与临时脚本
.cache/
# 测试依赖（tests/package.json 声明了依赖，具体安装不入库）
tests/node_modules/
# 个人 URL 列表（示例文件 urls.example.txt 才入库）
urls.txt
*.log
# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
# 打包产物（exe 部署在项目根目录，不入库；AsaseReader.spec 需要入库以便复现构建）
/build/
/dist/
/AsaseReader.exe
# 虚拟环境
.venv/
venv/
# 编辑器
.idea/
.vscode/

# 1.18.0 重写 gui.html 时的旧版备份：磁盘上留着，但不入库
*.bak

# 由 tools/gen_version_info.py 生成的版本资源（每次出包重新生成，勿入库）
/file_version_info.txt
/installer/version.iss
